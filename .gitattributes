# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# SQL files
*.sql text eol=lf

# PowerShell files
*.ps1 text eol=crlf

# Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Config files
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Environment files
.env* text eol=lf
